# The pipeline's role and its three customer-managed policies, imported as they are.
# They were generated by the CodePipeline console wizard in September 2025.
#
# NOTE for later: the service policy below is very broad (ec2:*, autoscaling:*, cloudformation:* and
# iam:PassRole on every resource, plus bucket-policy writes). It is kept faithful here on purpose. Narrowing
# it is a separate, planned change; the client portal's pipeline role (modules/client-portal-pipeline) shows a
# least-privilege version that was proven to deploy.
#
# Unlike the recruitment portal's role, this one has no read access to AWS's regional bucket
# (elasticbeanstalk-ap-southeast-2). A deploy that changes the environment's configuration may be refused with
# "S3 error: Access Denied" (see the recruitment portal's notes). Plain version swaps work.

resource "aws_iam_role" "pipeline" {
  name                 = "AWSCodePipelineServiceRole-ap-southeast-2-PartnerPortalReactUAT"
  path                 = "/service-role/"
  max_session_duration = 3600

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid    = "CodePipelineTrustPolicy"
      Effect = "Allow"
      Action = "sts:AssumeRole"
      Principal = {
        Service = "codepipeline.amazonaws.com"
      }
      Condition = {
        StringEquals = {
          "aws:SourceAccount" = "421089614203"
        }
      }
    }]
  })
}

resource "aws_iam_policy" "pipeline_service" {
  name        = "AWSCodePipelineServiceRole-ap-southeast-2-PartnerPortalReactUAT"
  path        = "/service-role/"
  description = "Policy used in trust relationship with CodePipeline for service role"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "AllowS3BucketAccess"
        Effect   = "Allow"
        Action   = ["s3:GetBucketVersioning", "s3:GetBucketAcl", "s3:GetBucketLocation"]
        Resource = ["arn:aws:s3:::codepipeline-ap-southeast-2-2428601742"]
        Condition = {
          StringEquals = {
            "aws:ResourceAccount" = "421089614203"
          }
        }
      },
      {
        Sid      = "AllowS3ObjectAccess"
        Effect   = "Allow"
        Action   = ["s3:PutObject", "s3:PutObjectAcl", "s3:GetObject", "s3:GetObjectVersion"]
        Resource = ["arn:aws:s3:::codepipeline-ap-southeast-2-2428601742/*"]
        Condition = {
          StringEquals = {
            "aws:ResourceAccount" = "421089614203"
          }
        }
      },
      {
        Sid      = "ElasticBeanstalkDeployment"
        Effect   = "Allow"
        Action   = ["elasticbeanstalk:CreateApplicationVersion", "elasticbeanstalk:UpdateEnvironment", "elasticbeanstalk:DescribeEnvironments", "elasticbeanstalk:DescribeApplicationVersions", "elasticbeanstalk:DescribeApplications", "elasticbeanstalk:CreateEnvironment", "elasticbeanstalk:TerminateEnvironment"]
        Resource = "*"
      },
      {
        Sid      = "S3ElasticBeanstalkEnvBuckets"
        Effect   = "Allow"
        Action   = ["s3:CreateBucket", "s3:PutBucketPolicy", "s3:GetBucketPolicy", "s3:PutBucketAcl", "s3:PutBucketOwnershipControls", "s3:GetBucketLocation", "s3:GetBucketAcl", "s3:ListBucket", "s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAcl", "s3:PutObject", "s3:PutObjectAcl", "s3:DeleteObject"]
        Resource = ["arn:aws:s3:::elasticbeanstalk-ap-southeast-2-421089614203", "arn:aws:s3:::elasticbeanstalk-ap-southeast-2-421089614203/*", "arn:aws:s3:::elasticbeanstalk-env-resources-ap-southeast-2", "arn:aws:s3:::elasticbeanstalk-env-resources-ap-southeast-2/*"]
      },
      {
        Sid      = "S3ArtifactBucketAccess"
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:PutObjectAcl", "s3:GetBucketLocation", "s3:ListBucket"]
        Resource = ["arn:aws:s3:::codepipeline-ap-southeast-2-2428601742", "arn:aws:s3:::codepipeline-ap-southeast-2-2428601742/*"]
      },
      {
        Sid      = "ElasticBeanstalkFullAccess"
        Effect   = "Allow"
        Action   = ["elasticbeanstalk:*", "cloudwatch:*", "cloudformation:*", "autoscaling:*", "ec2:*", "elasticloadbalancing:*", "sqs:*", "sns:*", "logs:*", "ssm:*", "iam:PassRole", "iam:GetRole"]
        Resource = "*"
      }
    ]
  })
}

resource "aws_iam_policy" "codebuild" {
  name        = "CodePipeline-CodeBuild-ap-southeast-2-PartnerPortalReactUAT"
  path        = "/service-role/"
  description = "Policy used in trust relationship with CodePipeline for CodeBuild Action"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["codebuild:BatchGetBuilds", "codebuild:StartBuild", "codebuild:BatchGetBuildBatches", "codebuild:StartBuildBatch"]
      Resource = ["arn:aws:codebuild:*:421089614203:project/PartnerPortalReact"]
    }]
  })
}

resource "aws_iam_policy" "connection" {
  name        = "CodePipeline-CodeConnections-ap-southeast-2-PartnerPortalReactUAT"
  path        = "/service-role/"
  description = "Policy used in trust relationship with CodePipeline for CodeConnections Action"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["codeconnections:UseConnection", "codestar-connections:UseConnection"]
      Resource = ["arn:aws:codestar-connections:*:421089614203:connection/977bfeb1-6c7b-470c-ab55-b70939019ef1", "arn:aws:codeconnections:*:421089614203:connection/977bfeb1-6c7b-470c-ab55-b70939019ef1"]
    }]
  })
}

resource "aws_iam_role_policy_attachment" "pipeline_service" {
  role       = aws_iam_role.pipeline.name
  policy_arn = aws_iam_policy.pipeline_service.arn
}

resource "aws_iam_role_policy_attachment" "codebuild" {
  role       = aws_iam_role.pipeline.name
  policy_arn = aws_iam_policy.codebuild.arn
}

resource "aws_iam_role_policy_attachment" "connection" {
  role       = aws_iam_role.pipeline.name
  policy_arn = aws_iam_policy.connection.arn
}
