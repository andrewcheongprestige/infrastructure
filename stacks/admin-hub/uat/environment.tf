# The Admin Hub React UAT Elastic Beanstalk environment, imported as it is: the Hub 2.0 React app, one Docker instance
# on Amazon Linux 2023, behind its own Elastic Beanstalk load balancer (a LoadBalanced environment, unlike the
# recruitment and partner portals). The pipeline (pipeline.tf) deploys new versions to it.
#
# This environment OWNS its load balancer. The load balancer, its port 80 listener, its default target group and their
# security groups are created by Elastic Beanstalk and belong to its CloudFormation stack, so they are not managed
# here. Other applications (Partner Portal and Variphy) share the load balancer's HTTPS listener, so rebuilding this
# environment would take their front door with it.
#
# Only the settings below are managed here. Everything else is left to Elastic Beanstalk and does not appear in a plan:
# the AMI, the generated environment variable parameter, the health reporting document, the security groups (the
# instance's and the load balancer's, both generated by Elastic Beanstalk) and the load balancer's default listener.
#
# Like the Partner Portal, it still uses the shared console-made instance role aws-elasticbeanstalk-ec2-role and the
# generated security group. Moving it to a dedicated role and group is a separate, later change.
#
# Changing a setting here is a live configuration update of the environment. Terraform applies it with its own
# credentials, not the pipeline's: the pipeline role is refused when a deploy changes the environment's configuration.
#
# The application (paf-adminhub-reactapp) is shared with Production and lives in stacks/admin-hub/shared.

data "aws_region" "current" {}

data "aws_caller_identity" "current" {}

locals {
  ssm_arn_prefix = "arn:aws:ssm:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:parameter"
}

resource "aws_elastic_beanstalk_environment" "uat" {
  name        = "paf-adminhub-reactapp-uat"
  application = "paf-adminhub-reactapp"
  tier        = "WebServer"

  # The platform at import. Managed platform updates move it on, so changes to it are ignored below.
  platform_arn = "arn:aws:elasticbeanstalk:ap-southeast-2::platform/Docker running on 64bit Amazon Linux 2023/4.13.10"

  # The Elastic Beanstalk service role (holds AWS-managed policies only). The full ARN, because the name alone
  # shows up as a permanent difference.
  setting {
    namespace = "aws:elasticbeanstalk:environment"
    name      = "ServiceRole"
    value     = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/aws-elasticbeanstalk-service-role"
  }

  # Its own application load balancer (the environment type itself is the default, LoadBalanced).
  setting {
    namespace = "aws:elasticbeanstalk:environment"
    name      = "LoadBalancerType"
    value     = "application"
  }

  # Instance
  setting {
    namespace = "aws:autoscaling:launchconfiguration"
    name      = "IamInstanceProfile"
    value     = "aws-elasticbeanstalk-ec2-role"
  }

  # An existing key pair, kept as it was set up.
  setting {
    namespace = "aws:autoscaling:launchconfiguration"
    name      = "EC2KeyName"
    value     = "TaskHostKeyPair"
  }

  setting {
    namespace = "aws:ec2:instances"
    name      = "InstanceTypes"
    value     = "t3.micro"
  }

  setting {
    namespace = "aws:autoscaling:asg"
    name      = "MaxSize"
    value     = "1"
  }

  setting {
    namespace = "aws:autoscaling:updatepolicy:rollingupdate"
    name      = "RollingUpdateEnabled"
    value     = "false"
  }

  # How the load balancer's default target group checks and treats the instance.
  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "Port"
    value     = "80"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "Protocol"
    value     = "HTTP"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "HealthCheckPath"
    value     = "/ping"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "MatcherHTTPCode"
    value     = "200"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "HealthCheckInterval"
    value     = "15"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "HealthCheckTimeout"
    value     = "5"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "HealthyThresholdCount"
    value     = "3"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "UnhealthyThresholdCount"
    value     = "5"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "DeregistrationDelay"
    value     = "20"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "StickinessEnabled"
    value     = "false"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "StickinessType"
    value     = "lb_cookie"
  }

  setting {
    namespace = "aws:elasticbeanstalk:environment:process:default"
    name      = "StickinessLBCookieDuration"
    value     = "86400"
  }

  # Plain settings the app reads. NON-SECRET values only, because they are stored in the Terraform state.
  setting {
    namespace = "aws:elasticbeanstalk:application:environment"
    name      = "NODE_ENV"
    value     = "UAT"
  }

  setting {
    namespace = "aws:elasticbeanstalk:application:environment"
    name      = "INTEGRATION_API_BASE_URI"
    value     = "https://uat.thehub.prestigeinhomecare.com.au/integration/"
  }

  setting {
    namespace = "aws:elasticbeanstalk:application:environment"
    name      = "HEALTH_CHECK_API_BASE_URI"
    value     = "https://uat.thehub.prestigeinhomecare.com.au/api/"
  }

  setting {
    namespace = "aws:elasticbeanstalk:application:environment"
    name      = "OAUTH_REDIRECT_URI"
    value     = "https://uat.thehub2.prestigeinhomecare.com.au/signin-oidc"
  }

  # Secrets: Elastic Beanstalk reads these from SSM when the instance starts. Only the ARN is stored here. The values
  # are never in Terraform, the build or the zip. The four Azure AD values already lived in SSM (plain String
  # parameters, shared with Production's build); SESSION_SECRET is its own SecureString.
  setting {
    namespace = "aws:elasticbeanstalk:application:environmentsecrets"
    name      = "AZURE_CLIENT_ID"
    value     = "${local.ssm_arn_prefix}/AzureAd/Hub2/ClientId"
  }

  setting {
    namespace = "aws:elasticbeanstalk:application:environmentsecrets"
    name      = "AZURE_CLIENT_SECRET"
    value     = "${local.ssm_arn_prefix}/AzureAd/Hub2/ClientSecret"
  }

  setting {
    namespace = "aws:elasticbeanstalk:application:environmentsecrets"
    name      = "AZURE_HUB_API_CLIENT_ID"
    value     = "${local.ssm_arn_prefix}/AzureAd/ClientId"
  }

  setting {
    namespace = "aws:elasticbeanstalk:application:environmentsecrets"
    name      = "AZURE_TENANT_ID"
    value     = "${local.ssm_arn_prefix}/AzureAd/TenantId"
  }

  setting {
    namespace = "aws:elasticbeanstalk:application:environmentsecrets"
    name      = "SESSION_SECRET"
    value     = "${local.ssm_arn_prefix}/UAT/AdminHub/SESSION_SECRET"
  }

  # Managed platform updates, kept as they were set up. The window is Monday 03:10 UTC, which is Monday 2:10 pm in
  # Sydney (working hours). Moving it to the weekend, like the client portal, is a separate decision.
  setting {
    namespace = "aws:elasticbeanstalk:managedactions"
    name      = "ManagedActionsEnabled"
    value     = "true"
  }

  setting {
    namespace = "aws:elasticbeanstalk:managedactions"
    name      = "PreferredStartTime"
    value     = "MON:03:10"
  }

  setting {
    namespace = "aws:elasticbeanstalk:managedactions:platformupdate"
    name      = "UpdateLevel"
    value     = "minor"
  }

  lifecycle {
    prevent_destroy = true

    # The pipeline moves the version on every release, and managed updates move the platform.
    ignore_changes = [version_label, platform_arn]
  }
}
