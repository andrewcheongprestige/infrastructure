# The PX2 UAT pipeline's role and its two customer-managed policies, imported as they are. They were generated by the
# CodePipeline console wizard in January 2026 and then edited by hand.
#
# Notes on what is in them:
#  - the service policy limits CloudFormation to this pipeline's two environments' stacks (awseb-e-i432djhbmj-stack is
#    the isolator, awseb-e-2iebz5rmem-stack the consumer), but allows starting any CodeBuild project (project/*),
#  - the CodeConnections policy allows TWO GitHub connections: the shared one (977bfeb1-...) used by the other
#    pipelines and a second one (5dc5d04e-...) that this pipeline does not currently use,
#  - like the other portals' roles it has no read access to AWS's regional bucket (elasticbeanstalk-ap-southeast-2), so
#    a deploy that changes an environment's configuration may be refused with "S3 error: Access Denied". Plain version
#    swaps work.
# They are kept faithful here on purpose: narrowing them is a separate, planned change.

resource "aws_iam_role" "pipeline" {
  name                 = "AWSCodePipelineServiceRole-ap-southeast-2-PX2-UAT"
  path                 = "/service-role/"
  max_session_duration = 3600

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid    = "CodePipelineTrustPolicy"
      Effect = "Allow"
      Action = "sts:AssumeRole"
      Principal = {
        Service = "codepipeline.amazonaws.com"
      }
      Condition = {
        StringEquals = {
          "aws:SourceAccount" = "421089614203"
        }
      }
    }]
  })
}

resource "aws_iam_policy" "pipeline_service" {
  name        = "AWSCodePipelineServiceRole-ap-southeast-2-PX2-UAT"
  path        = "/service-role/"
  description = "Policy used in trust relationship with CodePipeline for service role"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "AllowS3BucketAccess"
        Effect   = "Allow"
        Action   = ["s3:GetBucketVersioning", "s3:GetBucketAcl", "s3:GetBucketLocation"]
        Resource = ["arn:aws:s3:::codepipeline-ap-southeast-2-2428601742"]
        Condition = {
          StringEquals = {
            "aws:ResourceAccount" = "421089614203"
          }
        }
      },
      {
        Sid      = "AllowS3ObjectAccess"
        Effect   = "Allow"
        Action   = ["s3:PutObject", "s3:PutObjectAcl", "s3:GetObject", "s3:GetObjectVersion"]
        Resource = ["arn:aws:s3:::codepipeline-ap-southeast-2-2428601742/*"]
        Condition = {
          StringEquals = {
            "aws:ResourceAccount" = "421089614203"
          }
        }
      },
      {
        Sid      = "AllowCodeBuildAccess"
        Effect   = "Allow"
        Action   = ["codebuild:StartBuild", "codebuild:BatchGetBuilds"]
        Resource = "arn:aws:codebuild:ap-southeast-2:421089614203:project/*"
      },
      {
        Sid      = "AllowElasticBeanstalkDeployment"
        Effect   = "Allow"
        Action   = ["elasticbeanstalk:CreateApplicationVersion", "elasticbeanstalk:DescribeApplicationVersions", "elasticbeanstalk:UpdateEnvironment"]
        Resource = "*"
      },
      {
        Sid      = "AllowElasticBeanstalkS3BucketManagement"
        Effect   = "Allow"
        Action   = ["s3:CreateBucket", "s3:PutBucketPolicy", "s3:PutBucketAcl", "s3:GetBucketLocation", "s3:PutObject", "s3:PutObjectAcl", "s3:GetObject", "s3:GetObjectVersion", "s3:DeleteObject", "s3:ListBucket", "s3:GetObjectAcl", "s3:GetBucketPolicy"]
        Resource = ["arn:aws:s3:::elasticbeanstalk-ap-southeast-2-421089614203", "arn:aws:s3:::elasticbeanstalk-ap-southeast-2-421089614203/*"]
      },
      {
        Sid      = "AllowElasticBeanstalkDescribe"
        Effect   = "Allow"
        Action   = ["elasticbeanstalk:DescribeEnvironments"]
        Resource = "*"
      },
      {
        Sid      = "AllowCloudFormationGetTemplate"
        Effect   = "Allow"
        Action   = ["cloudformation:GetTemplate", "cloudformation:DescribeStackResource", "cloudformation:DescribeStackResources", "cloudformation:UpdateStack", "cloudformation:DescribeStacks", "cloudformation:ValidateTemplate", "cloudformation:GetTemplateSummary"]
        Resource = ["arn:aws:cloudformation:ap-southeast-2:421089614203:stack/awseb-e-i432djhbmj-stack/*", "arn:aws:cloudformation:ap-southeast-2:421089614203:stack/awseb-e-2iebz5rmem-stack/*"]
      },
      {
        Effect   = "Allow"
        Action   = ["autoscaling:SuspendProcesses", "autoscaling:ResumeProcesses", "autoscaling:DescribeAutoScalingGroups"]
        Resource = "*"
      },
      {
        Sid      = "AllowElasticBeanstalkPolling"
        Effect   = "Allow"
        Action   = ["elasticbeanstalk:DescribeEvents", "elasticbeanstalk:DescribeEnvironmentHealth"]
        Resource = "*"
      },
      {
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAcl"]
        Resource = ["arn:aws:s3:::codepipeline-ap-southeast-2-2428601742/*"]
      },
      {
        Effect   = "Allow"
        Action   = "s3:ListBucket"
        Resource = "arn:aws:s3:::codepipeline-ap-southeast-2-2428601742"
      },
      {
        Sid      = "AllowElasticBeanstalkEnvResourcesAccess"
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:GetObjectVersion", "s3:GetBucketLocation"]
        Resource = ["arn:aws:s3:::elasticbeanstalk-env-resources-ap-southeast-2", "arn:aws:s3:::elasticbeanstalk-env-resources-ap-southeast-2/*"]
      },
      {
        Sid      = "AllowEC2DescribeKeyPairs"
        Effect   = "Allow"
        Action   = ["ec2:DescribeKeyPairs", "ec2:DescribeImages"]
        Resource = "*"
      }
    ]
  })
}

resource "aws_iam_policy" "connection" {
  name        = "CodePipeline-CodeConnections-ap-southeast-2-PX2-UAT"
  path        = "/service-role/"
  description = "Policy used in trust relationship with CodePipeline for CodeConnections Action"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = ["codeconnections:UseConnection", "codestar-connections:UseConnection"]
      Resource = [
        "arn:aws:codestar-connections:*:421089614203:connection/5dc5d04e-88b0-409c-a94d-b4987b806fd8",
        "arn:aws:codeconnections:*:421089614203:connection/5dc5d04e-88b0-409c-a94d-b4987b806fd8",
        "arn:aws:codestar-connections:*:421089614203:connection/977bfeb1-6c7b-470c-ab55-b70939019ef1",
        "arn:aws:codeconnections:*:421089614203:connection/977bfeb1-6c7b-470c-ab55-b70939019ef1"
      ]
    }]
  })
}

resource "aws_iam_role_policy_attachment" "pipeline_service" {
  role       = aws_iam_role.pipeline.name
  policy_arn = aws_iam_policy.pipeline_service.arn
}

resource "aws_iam_role_policy_attachment" "connection" {
  role       = aws_iam_role.pipeline.name
  policy_arn = aws_iam_policy.connection.arn
}
