# Registers the environment's Auto Scaling group with the target group Recruitment-UAT (front_door.tf). That
# registration is what lets the shared Hub 1.0 UAT load balancer send the portal's traffic to the instance. It was
# first made by hand, and Elastic Beanstalk does not do it for a single-instance environment.
#
# The group's name is generated by Elastic Beanstalk, so it is taken from the environment instead of being typed in.
#
# If Elastic Beanstalk ever recreates the group (for example after the environment is rebuilt), the registration is
# lost and the site returns 503 until this is applied again. Terraform does not do that on its own.
resource "aws_autoscaling_attachment" "uat" {
  autoscaling_group_name = aws_elastic_beanstalk_environment.uat.autoscaling_groups[0]
  lb_target_group_arn    = aws_lb_target_group.uat.arn

  # Destroying this detaches the target group and the site returns 503, so Terraform is told never to.
  lifecycle {
    prevent_destroy = true
  }
}
